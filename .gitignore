# ==============================================================================
# .gitignore — Oroboros Martelinho de Ouro (martelinhodigital.online)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Arquivos brutos / Staging que não são necessários para o site em produção
# (O site utiliza exclusivamente os arquivos otimizados em assets/img/)
# ------------------------------------------------------------------------------
image/

# Arquivos de especificações e prompts internos
*.md.bak
SKILL*.md

# ------------------------------------------------------------------------------
# 2. Sistema Operacional (OS)
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 3. Editores de Código & IDEs
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (IntelliJ, WebStorm, PhpStorm, etc.)
.idea/
*.iws
*.iml
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs
*.swp
*.swo
*.swn
.*.sw[a-z]
*.bak
*~
.#*
\#*#

# ------------------------------------------------------------------------------
# 4. Ambiente, Segredos e Chaves
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# 5. Logs, Cache e Temporários
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

.cache/
.temp/
.tmp/
tmp/
temp/
*.tmp
*.temp

# ------------------------------------------------------------------------------
# 6. Gerenciadores de Pacotes & Builds (caso utilize no futuro)
# ------------------------------------------------------------------------------
node_modules/
dist/
build/
out/
.output/
.parcel-cache/
.next/
.nuxt/

# ------------------------------------------------------------------------------
# 7. Python (servidores locais / scripts)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
